# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Somente no servidor (Vercel > Settings > Environment Variables). Nunca use NEXT_PUBLIC_ aqui.
# Job diário de recorrências: chave service_role (Supabase > Project Settings > API Keys > secret)
SUPABASE_SERVICE_ROLE_KEY=
# Segredo qualquer e longo; a Vercel envia no cabeçalho Authorization do cron
CRON_SECRET=

# Avisos por e-mail (opcional)
RESEND_API_KEY=
EMAIL_FROM=
